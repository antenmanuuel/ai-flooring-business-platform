# Copy to ai/.env and fill in. Write values without quotes.

# Claude API key from https://console.anthropic.com (required for answers).
ANTHROPIC_API_KEY=

# Model that writes the answers.
AI_MODEL=claude-opus-5-5

# Where the catalog is read from (the Spring Boot server's public products endpoint).
CATALOG_URL=http://localhost:5050/api/products
# Where Anna's assistant reads live requests, clients and products (with her login cookie).
ADMIN_API_URL=http://localhost:5050/api/admin

# Public chat limits per visitor.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
