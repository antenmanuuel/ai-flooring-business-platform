# Copy to ai/.env and fill in. Write values without quotes.

# Claude API key from https://console.anthropic.com (required for answers).
ANTHROPIC_API_KEY=

# Model that writes the answers.
AI_MODEL=claude-opus-5-5

# Where the catalog is read from (the Spring Boot server's public products endpoint).
CATALOG_URL=http://localhost:5050/api/products
# Where Anna's assistant reads live requests, clients and products (with her login cookie).
ADMIN_API_URL=http://localhost:5050/api/admin
# Where a logged-in client's assistant reads their own quote requests (with their login cookie).
CLIENT_API_URL=http://localhost:5050/api/client

# How often the catalog is re-read so prices and products stay current, in minutes (0 = never).
CATALOG_REFRESH_MINUTES=10

# Public chat limits per visitor.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
# Questions per day for the whole site (public and client chats together): a ceiling on the Claude bill.
SITE_DAILY_QUESTION_LIMIT=1000
# Proxies in front of the assistant that add to X-Forwarded-For: 1 for nginx or the Vite proxy,
# 2 if a load balancer sits in front of nginx.
TRUSTED_PROXY_HOPS=1
