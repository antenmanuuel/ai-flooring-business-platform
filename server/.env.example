# Copy this file to .env and fill in the blanks. Write values without quotes.
PORT=5050

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# `npm run db:setup` creates this database if it doesn't exist.
DB_NAME=anna_flooring_springboot_db

# Secret used to sign login tokens (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to true when the site is served over HTTPS so the login cookie is only sent securely.
COOKIE_SECURE=false
