{
  "name": "server",
  "private": true,
  "description": "npm shortcuts for the Spring Boot server. They run the Maven wrapper (mvnw) for you.",
  "scripts": {
    "dev": "node scripts/mvnw.mjs -ntp -q spring-boot:run",
    "start": "node scripts/mvnw.mjs -ntp -q spring-boot:run",
    "db:setup": "node scripts/mvnw.mjs -ntp -q compile spring-boot:run -Pdb-setup",
    "compile": "node scripts/mvnw.mjs -ntp -q compile",
    "build": "node scripts/mvnw.mjs -ntp -q package"
  }
}
